# TecGate — copy this file to .env and fill in the two values.
#
#     cp .env.example .env
#
# The placeholders below come from ranges reserved for documentation.
# They work nowhere on purpose — a template that happens to start never
# gets filled in. Both are required; a missing one stops
# `docker compose up` with a sentence naming it.


# The mail address of your Let's Encrypt account. Expiry warnings go
# there. Let's Encrypt does not check that the address exists.
ACME_EMAIL=admin@example.com

# The names the web interface's own certificate should carry. Usually
# the address at which THIS machine is reachable on your own network;
# separate several with commas. If the
# name you actually use is missing, the browser warns on every visit.
CERT_NAMES=192.168.1.10

# Optional: pin the image version. Left commented out you follow
# :latest, and `docker compose pull` brings whatever is newest.
# TECGATE_VERSION=latest
